set_global_assignment -name IP_SEARCH_PATHS "custom_ip/**/*"

set_global_assignment -name FAMILY "Agilex 27"
set_global_assignment -name TOP_LEVEL_ENTITY baseline_a520
set_global_assignment -name LAST_QUARTUS_VERSION "26.3.0 Pro Edition"

set_global_assignment -name DEVICE A27_WHITEBOARD_PART

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Variant RTL source files
set_global_assignment -name SYSTEMVERILOG_FILE baseline_a520.sv
